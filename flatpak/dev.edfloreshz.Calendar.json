{
  "id": "dev.edfloreshz.Calendar",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "cosmic-ext-calendar",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--filesystem=xdg-config/cosmic:ro",
    "--env=ACCOUNTS_GOOGLE_CALENDAR_CLIENT_ID=55442946345-2pe09fdpbsn9edchqir97j0thrms0h3s.apps.googleusercontent.com",
    "--env=ACCOUNTS_GOOGLE_CALENDAR_CLIENT_SECRET=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",
    "--env=ACCOUNTS_MICROSOFT_CALENDAR_CLIENT_ID=e101661d-a2f1-40ac-91b1-424274317b70"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "calendar",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/calendar/cargo"
        }
      },
      "build-commands": [
        "cargo build --release --frozen",
        "install -Dm0755 target/release/cosmic-ext-calendar /app/bin/cosmic-ext-calendar",
        "install -Dm0644 resources/app.desktop /app/share/applications/dev.edfloreshz.Calendar.desktop",
        "install -Dm0644 resources/app.metainfo.xml /app/share/metainfo/dev.edfloreshz.Calendar.metainfo.xml",
        "install -Dm0644 resources/icons/hicolor/scalable/apps/icon.svg /app/share/icons/hicolor/scalable/apps/dev.edfloreshz.Calendar.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [".cargo", ".git", ".flatpak-builder", ".flatpak-cargo", "dist", "target", "vendor", "vendor.tar"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
